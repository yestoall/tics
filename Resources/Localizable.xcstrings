    "TICS solo escucha cuándo pulsas y sueltas esos botones. No cambia nada de tu ratón.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TICS only listens for when you press and release those buttons. It doesn't change anything on your mouse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TICS solo escucha cuándo pulsas y sueltas esos botones. No cambia nada de tu ratón."
          }
        }
      }
    },
    "TICS solo mira qué pulsas y cómo arrastras, para elegir el sonido. No guarda nada de lo que escribes ni dónde haces clic.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TICS only looks at what you press and how you drag, to pick the sound. It never saves what you type or where you click."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TICS solo mira qué pulsas y cómo arrastras, para elegir el sonido. No guarda nada de lo que escribes ni dónde haces clic."
          }
        }
      }
    },
